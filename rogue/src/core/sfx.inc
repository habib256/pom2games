; ============================================================================
; sfx.inc -- ROGUE's sounds on the Apple II speaker
; ============================================================================
; The Apple-1 game was silent. Events of a turn queue one sound (SFX id: the
; highest id of the turn wins, ids are ordered by importance); main_loop
; plays it (sfx_flush) once the turn's picture is on the card, before it
; waits for the next key. SFX_NOW plays at once (scroll map, dagger throw).
; A sound is a busy loop on $C030 between two VDP accesses: it only makes
; that gap longer, never shorter, so the 18-cycle VDP contract holds.
;
;   sfx_queue     A = id: kept if higher than the pending one. Keeps X, Y.
;   sfx_flush     plays the pending sound, if any, and clears it.
;   sfx_play      A = id: plays it now. Clobbers A, X, Y.
;   sound_toggle  snd_on ^= 1, Apple text status line; A/Y = message.
;   tune_once     A/Y = a tune for tune_tick, played once (no loop).
;   wait_key_stir wait_key that steps the PRNG while it waits.
;
; Sound data (sfx_data, sfx_start, tune_*) is generated by tools/music.py
; into music.inc: a sound is a list of (tone X, tone A) pairs ended by 0.
; ============================================================================

; (The SFX / SFX_NOW macros are at the top of rogue.s: used before this.)

.segment "BSS"
snd_on:         .res 1          ; 1 = sounds and tunes on (sound.asm's gate)
sfx_req:        .res 1          ; pending sound of this turn, 0 = none
sfx_y:          .res 1          ; sfx_play's cursor across tone

.segment "CODE"

sfx_queue:
        CMP     sfx_req
        BCC     @keep
        STA     sfx_req
@keep:  RTS

sfx_flush:
        LDA     sfx_req
        BEQ     sfx_rts
        LDX     #0
        STX     sfx_req
        ; fall through
sfx_play:
        TAX
        LDY     sfx_start-1,X   ; ids start at 1
@note:  LDA     sfx_data,Y      ; tone X (half period), 0 = end
        BEQ     sfx_rts
        TAX
        LDA     sfx_data+1,Y    ; tone A (flips)
        INY
        INY
        STY     sfx_y
        JSR     tone
        LDY     sfx_y
        JMP     @note
sfx_rts:
        RTS

; sound_toggle -- flips snd_on, rewrites the Apple text page's status line;
; A/Y = the card's row-23 message.
sound_toggle:
        LDA     snd_on
        EOR     #1
        STA     snd_on
        LDA     snd_on
        JSR     plat_sound_status ; the binary shows it (or not)
        LDA     #<msg_snd_on
        LDY     #>msg_snd_on
        LDX     snd_on
        BNE     @on
        LDA     #<msg_snd_off
        LDY     #>msg_snd_off
@on:    RTS

tune_once:
        JSR     tune_start
        LDA     #0
        STA     tune_loop+1     ; tune.asm: no loop, tune_ptr+1 = 0 at the end
        RTS

; wait_key_stir -- wait_key (A = key, bit 7 set), the PRNG stepping meanwhile:
; the time the player takes on the briefing page joins the title's seed.
wait_key_stir:
        JSR     vid_idle        ; the back-end finishes the picture
@lp:    JSR     prng16
        LDA     KBD
        BPL     @lp
        STA     KBDSTRB
        JMP     key_xlate

; key_xlate -- A = key with bit 7 set: lower case -> upper case, arrows ->
; the IJKL movement keys (left/right on every Apple II, up/down on a //e).
key_xlate:
        CMP     #('a' | $80)
        BCC     @arrows
        CMP     #('z' | $80) + 1
        BCS     @done
        AND     #$DF
        RTS
@arrows:
        CMP     #(KC_LEFT | $80)
        BNE     @r
        LDA     #('J' | $80)
@r:     CMP     #(KC_RIGHT | $80)
        BNE     @u
        LDA     #('L' | $80)
@u:     CMP     #(KC_UP | $80)
        BNE     @d
        LDA     #('I' | $80)
@d:     CMP     #(KC_DOWN | $80)
        BNE     @done
        LDA     #('K' | $80)
@done:  RTS
