; ============================================================================
; sfx.inc -- ROGUE's sounds on the Apple II speaker
; ============================================================================
; The Apple-1 game was silent. Events of a turn queue one sound (SFX id: the
; highest id of the turn wins, ids are ordered by importance); main_loop
; plays it (sfx_flush) once the turn's picture is shown (vid_idle first: the
; DHGR back-end draws there; the card already shows it), before it
; waits for the next key. SFX_NOW plays at once (scroll map, dagger throw).
; A sound is a busy loop on $C030 between two VDP accesses: it only makes
; that gap longer, never shorter, so the 18-cycle VDP contract holds.
;
;   sfx_queue     A = id: kept if higher than the pending one. Keeps X, Y.
;   sfx_flush     plays the pending sound, if any, and clears it.
;   sfx_play      A = id: plays it now. Clobbers A, X, Y.
;   sound_toggle  snd_on ^= 1, Apple text status line; A/Y = message.
;   tune_once     A/Y = a tune for tune_tick, played once (no loop).
;   music_title / music_death / music_win  the three tunes: title (once,
;                 the title loop ticks it), death and victory (blocking on
;                 the speaker).
;   wait_key_stir wait_key that steps the PRNG while it waits.
;
; Mockingboard (SND_MB = 1, the binary's choice): snd_init looks for a card
; (mb_detect: slots 7..1 but 3; the E-Z Color card's slot answers no VIA).
; With one, every sound and tune is an AYS song (music.inc's SNDDATA, made
; by tools/music.py) played by aysong.asm on mb_irq.asm's 50 Hz interrupt:
; nothing waits for it (a new sound replaces the one playing), the speaker
; stays silent. Without one, the speaker as above.
;   snd_init      once at start: card -> snd_mb = slot, the service on.
;   snd_exit      the service off, both chips silent (APPLE2_EXIT_HOOK:
;                 ESC and Ctrl-RESET; DOS's zero page is back, so mb_ptr's
;                 two bytes are kept). Harmless without a card.
;
; Sound data (sfx_data, sfx_start, tune_*) is generated by tools/music.py
; into music.inc: a sound is a list of (tone X, tone A) pairs ended by 0.
; ============================================================================

; (The SFX / SFX_NOW macros are at the top of rogue.s: used before this.)

.segment "BSS"
snd_on:         .res 1          ; 1 = sounds and tunes on (sound.asm's gate)
.if SND_MB
snd_mb:         .res 1          ; Mockingboard slot, 0 = none (the speaker)
snd_gate:       .res 1          ; mb_irq's gate: 0 = no song loaded yet
.endif
sfx_req:        .res 1          ; pending sound of this turn, 0 = none
sfx_y:          .res 1          ; sfx_play's cursor across tone

.segment "CODE"

sfx_queue:
        CMP     sfx_req
        BCC     @keep
        STA     sfx_req
@keep:  RTS

sfx_flush:
        LDA     sfx_req
        BEQ     sfx_rts
        LDX     #0
        STX     sfx_req
        ; fall through
sfx_play:
.if SND_MB
        LDX     snd_mb
        BEQ     @spk
        TAX
        LDA     ays_sfx_lo-1,X  ; ids start at 1
        LDY     ays_sfx_hi-1,X
        JMP     snd_song
@spk:
.endif
        TAX
        LDY     sfx_start-1,X   ; ids start at 1
@note:  LDA     sfx_data,Y      ; tone X (half period), 0 = end
        BEQ     sfx_rts
        TAX
        LDA     sfx_data+1,Y    ; tone A (flips)
        INY
        INY
        STY     sfx_y
        JSR     tone
        LDY     sfx_y
        JMP     @note
sfx_rts:
        RTS

; sound_toggle -- flips snd_on, rewrites the Apple text page's status line;
; A/Y = the card's row-23 message.
sound_toggle:
        LDA     snd_on
        EOR     #1
        STA     snd_on
.if SND_MB
        JSR     snd_mute        ; the song keeps its time, heard or not
.endif
        LDA     snd_on
        JSR     plat_sound_status ; the binary shows it (or not)
        LDA     #<msg_snd_on
        LDY     #>msg_snd_on
        LDX     snd_on
        BNE     @on
        LDA     #<msg_snd_off
        LDY     #>msg_snd_off
@on:    RTS

tune_once:
        JSR     tune_start
        LDA     #0
        STA     tune_loop+1     ; tune.asm: no loop, tune_ptr+1 = 0 at the end
        RTS

music_title:
.if SND_MB
        LDA     #<ays_title
        LDY     #>ays_title
        LDX     snd_mb
        BNE     snd_song        ; (tune_ptr+1 stays 0: the title loop
.endif                          ; only spins)
        LDA     #<tune_title
        LDY     #>tune_title
        JMP     tune_once

music_death:
.if SND_MB
        LDA     #<ays_death
        LDY     #>ays_death
        LDX     snd_mb
        BNE     snd_song
.endif
        LDA     #<tune_death
        LDY     #>tune_death
        JMP     tune_play

music_win:
.if SND_MB
        LDA     #<ays_win
        LDY     #>ays_win
        LDX     snd_mb
        BNE     snd_song
.endif
        LDA     #<tune_win
        LDY     #>tune_win
        JMP     tune_play

.if SND_MB
; snd_song -- A/Y = an AYS song: it replaces the one playing, from its start.
snd_song:
        PHP
        SEI                     ; ays_init with the tick held off
        JSR     ays_init
        LDA     #1
        STA     snd_gate
        JSR     snd_mute        ; ays_init cleared the mute mask
        PLP
        RTS

; snd_mute -- the three voices muted while snd_on = 0 (aysong.asm's mask).
snd_mute:
        LDA     snd_on
        BEQ     @all
        LDA     #0
        JMP     ays_mute
@all:   LDA     #7
        JMP     ays_mute

snd_init:
        LDA     #0
        STA     snd_gate
        STA     tune_ptr+1      ; no speaker tune (tune.asm)
        JSR     mb_detect       ; A = slot, 0 = none (its PLP: flags not set)
        STA     snd_mb
        TAX
        BEQ     @none
        JSR     mb_forget
        JSR     mb_irq_start    ; T1 at 50 Hz on $03FE, then CLI
@none:  RTS

snd_exit:
        LDA     snd_mb
        BEQ     @none
        LDA     z:mb_ptr        ; DOS's zero page by now: keep these two
        PHA
        LDA     z:mb_ptr+1
        PHA
        JSR     mb_irq_stop
        PLA
        STA     z:mb_ptr+1
        PLA
        STA     z:mb_ptr
@none:  RTS
.endif

; wait_key_stir -- wait_key (A = key, bit 7 set), the PRNG stepping meanwhile:
; the time the player takes on the briefing page joins the title's seed.
wait_key_stir:
        JSR     vid_idle        ; the back-end finishes the picture
@lp:    JSR     prng16
        LDA     KBD
        BPL     @lp
        STA     KBDSTRB
        JMP     key_xlate

; key_xlate -- A = key with bit 7 set: lower case -> upper case, arrows ->
; the IJKL movement keys (left/right on every Apple II, up/down on a //e).
key_xlate:
        CMP     #('a' | $80)
        BCC     @arrows
        CMP     #('z' | $80) + 1
        BCS     @done
        AND     #$DF
        RTS
@arrows:
        CMP     #(KC_LEFT | $80)
        BNE     @r
        LDA     #('J' | $80)
@r:     CMP     #(KC_RIGHT | $80)
        BNE     @u
        LDA     #('L' | $80)
@u:     CMP     #(KC_UP | $80)
        BNE     @d
        LDA     #('I' | $80)
@d:     CMP     #(KC_DOWN | $80)
        BNE     @done
        LDA     #('K' | $80)
@done:  RTS
