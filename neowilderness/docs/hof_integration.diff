-; module_restart -- after a game (QUIT, death, arrival): restore the system
-; as for ProDOS (prodos_restore: text, /RAM, bitmap, RESET, zero page), then
-; read NEOWILD.SYSTEM again to $2000 and run it: the start menu of a fresh
-; loader, no state kept. Its path is NEOWILD.GEO's (memory.s, built by the
-; loader) with GEO replaced by SYSTEM. Any MLI error leaves to ProDOS.
-; Runs in the $5800 window: the file never reaches it.
-module_restart:
-        jsr     prodos_restore
-        ldx     #$FF
-        txs
-        ldx     geo_path
-        beq     @fail
-        ldy     #0
-:       lda     geo_path,y
-        sta     restart_path,y
-        iny
-        dex
-        bpl     :-
-        ldx     #0              ; "GEO" -> "SYSTEM"
-        ldy     geo_path
-        dey
-        dey
-:       lda     restart_system,x
-        sta     restart_path,y
-        iny
-        inx
-        cpx     #6
-        bne     :-
-        dey
-        sty     restart_path
-        lda     #$C8            ; OPEN
-        ldx     #<restart_open
-        ldy     #>restart_open
-        jsr     mli_call
-        bcs     @fail
-        lda     restart_open+5
-        sta     restart_read+1
-        sta     restart_close+1
-        lda     #$CA            ; READ: the whole file, below this window
-        ldx     #<restart_read
-        ldy     #>restart_read
-        jsr     mli_call
-        bcs     @fail
-        lda     #$CC            ; CLOSE
-        ldx     #<restart_close
-        ldy     #>restart_close
-        jsr     mli_call
-        bcs     @fail
-        jmp     $2000
-@fail:  jmp     prodos_quit
-restart_system: .byte "SYSTEM"
-restart_open:   .byte 3
-                .word restart_path, io_buffer
-                .byte 0
-restart_read:   .byte 4, 0
-                .word $2000, $5800-$2000, 0
-restart_close:  .byte 1, 0
-restart_path:   .res 44
-.export module_restart
+        .include "hof_load.inc" ; module_end, module_restart (lot 7)
