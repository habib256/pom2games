; zp_boot.inc -- zero page used by the boot loader
; Generated by tools/gen.py.

ld_dst         = $00            ; ptr: destination page of the sector being decoded
ld_htrack      = $02            ; current head position in half-tracks
ld_ntracks     = $03            ; tracks left in the current load-table entry
ld_page        = $04            ; destination page for physical sector 0 of the current track
ld_aux         = $05            ; nonzero = write to auxiliary RAM (unused: all entries are 0)
ld_lastcnt     = $06            ; number of sectors to read on the LAST track of the entry
ld_want        = $07            ; sectors wanted on this track (16, or ld_lastcnt)
ld_left        = $08            ; sectors still to read on this track
ld_tmp         = $09            ; scratch / nibble index
ld_tmp2        = $0A            ; target half-track / checksum
ld_tmp3        = $0B            ; scratch (4&4 decode)
ld_entry       = $0C            ; offset of the current entry in load_table
ld_track       = $0D            ; current track number
ld_ticks       = $0E            ; elapsed-time accumulator, in sector times (80 = one second)
ld_secs        = $0F            ; elapsed seconds shown on screen (max 99)
ld_addr        = $10            ; address field: volume, track, sector, checksum ($10-$13)
ld_addr_trk    = $11            ; address field track
ld_addr_sec    = $12            ; address field sector (physical)
ld_lastsec     = $1A            ; sector number of the previous address field
ld_scr         = $1B            ; ptr: text-screen row for print_dec2
ld_txt         = $1D            ; ptr: walks the text records
ld_trkcount    = $1F            ; tracks started so far (shown as "Track nn")
prom_buf       = $26            ; boot PROM data-buffer pointer (lo)
prom_bufhi     = $27            ; boot PROM buffer pointer (hi)
prom_slot16    = $2B            ; boot slot * 16 (left by the PROM)
ld_secmap      = $30            ; 16 flags, one per physical sector: 1 = still wanted
prom_sector    = $3D            ; sector the PROM is asked to read next
prom_vec       = $3E            ; PROM read-sector entry ($Cn5C)
ld_done        = $40            ; sectors loaded so far (drives the progress bar)
ld_aux2        = $A0            ; $A0-$F5: the 86 "2-bit" nibbles of a 6&2 sector
